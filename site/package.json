{
	"name": "bield-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run build:docs && bun scripts/sitemap.ts",
		"build:docs": "cd docs-site && bun run build",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"test": "bun test demo src scripts",
		"links": "bun scripts/check-links.ts",
		"demo": "bun demo/build.ts",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"links:external": "bun scripts/check-links.ts --external"
	},
	"devDependencies": {
		"@fontsource-variable/host-grotesk": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
